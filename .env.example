# LLM (답변 생성) — Anthropic Claude
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SEC=120
# 주의: claude-sonnet-5 는 temperature 를 지원하지 않는다 (400).
#       LLM_TEMPERATURE 는 LLM_PROVIDER=google 일 때만 적용된다.

# 임베딩 (검색 · Q&A 캐시 · 인젝션 탐지) — Google Gemini
# Anthropic 은 임베딩 API 를 제공하지 않으므로 이 키는 제거할 수 없다.
GEMINI_API_KEY=

# A/B 비교용 레거시 경로 (LLM_PROVIDER=google 일 때만 사용)
# GOOGLE_MODEL=gemini-3-flash-preview
# LLM_TEMPERATURE=0

# Admin 초기 계정
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Session
SESSION_SECRET=

# DynamoDB
AWS_REGION=ap-northeast-1
USERS_TABLE=langgraph_users
ROUTING_LOG_TABLE=langgraph_routing_logs
INTENT_SAMPLES_TABLE=langgraph_intent_samples
CREATE_USERS_TABLE=1
CREATE_ROUTING_LOG_TABLE=1
CREATE_INTENT_SAMPLES_TABLE=1

# LangSmith (선택)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=langgraph-rag
LANGSMITH_WORKSPACE_ID=

# RAG
AUTO_INGEST=1
KNOWLEDGE_DIR=./knowledge_data
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=my_knowledge

# S3 Knowledge Sync (설정 시 startup 때 S3에서 knowledge_data 동기화)
S3_KNOWLEDGE_BUCKET=langgraph-rag-333347414948-ap-northeast-1-an
S3_KNOWLEDGE_PREFIX=knowledge_data/

# Thread Context (user | task)
THREAD_CONTEXT_SCOPE=user